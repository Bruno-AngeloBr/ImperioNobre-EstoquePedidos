@using ImperioNobre.Models.ViewModels
@model AddPedidoViewModel

@{
    Layout = "_LayoutVendedor";
}

@{
    ViewData["Title"] = "AddPedido";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Adicionar - Pedido</h2>
    <button type="submit" class="btn btn-primary">Salvar Pedido</button>
</div>

<br />

<div class="mb-3">
    <label for="pedidoId" class=" form-label lbPedido">Pedido ID: </label>
    <input type="text" class="form-control-sm" id="pedidoId" value="" readonly>
</div>

<div class="mb-3">
    <label for="quantidade" class="form-label lbPedido">Número da Remessa: </label>
    <input type="number" name="quantidade"
           class="form-control-sm input-pequeno"
           min="1" step="1" value="1">
</div>

<!--Nome do cliente-->
<div class="mb-3">
    <label for="cliente" class="form-label lbPedido">Cliente:</label>
    <select id="cliente" name="produto" class="form-select">
        @foreach (var item in Model.Clientes)
        {
            <option value=@item.ClientID>@item.Nome</option>
        }
    </select>
</div>

<!--Exibir ProdutoID / Nome / Sabor-->
<table id="tabelaItens" class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Produto</th>
            <th>Quantidade</th>
            <th>Preço Unitário</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <select class="form-select form-select-sm">
                    <option value="" selected disabled>Selecione</option>
                    @foreach (var item in Model.Produtos)
                    {
                        @if (item.QtdDisponivel != 0)
                        {
                            <option value=@item.ProdutosID>@item.Nome - @item.Sabor | @item.Tamanho g</option>
                        }
                    }
                </select>
                <small id="qtdDisponivel" class="text-danger">Disponível: 5 unidades</small>
            </td>
            <td>
                <input type="number" class="form-control form-control-sm" min="1" step="1" value="1">
            </td>
            <td>
                <input type="number" class="form-control form-control-sm" step="0.01" value="0.00">
            </td>
            <td>
                <input type="text" class="form-control form-control-sm" readonly value="0.00">
            </td>
            <td>
                <button type="button" class="btn btn-danger btn-sm" onclick="removerLinha(this)">Delete</button>
            </td>
        </tr>
        <!-- Você pode repetir <tr> para mais linhas -->
    </tbody>
</table>

<button type="submit" class="btn btn-primary" onclick="adicionarLinha()">+ Adicionar item</button>
<br />
<br />
<br />

<div>
    <label for="TotalPedido" class=" form-label lbPedido">Total: R$ 50,00</label>
</div>


<script>
    //Atualizando o ID do cliente no pedido
    const cliente = document.getElementById("cliente");
    const pedidoId = document.getElementById("pedidoId");

    function atualizarClienteID() {
        pedidoId.value = cliente.value;
    }

    // Quando o usuário trocar o cliente
    cliente.addEventListener("change", atualizarClienteID);

    // Quando a página carregar
    atualizarClienteID();


    function adicionarLinha() {
        const tbody = document.querySelector("#tabelaItens tbody");
        const novaLinha = document.createElement("tr");

        novaLinha.innerHTML = `
          <td>
            <select class="form-select form-select-sm">
              <option value="" selected disabled>Selecione</option>
              <option value="1">Cookie - Oreo Black | 110g | R$14</option>
              <option value="2">Cookie - Nutella | 110g | R$14</option>
              <option value="3">Mini Cookie - Tradicional | 50g | R$7</option>
            </select>
            <small class="text-danger">Disponível: 5 unidades</small>
          </td>
          <td>
            <input type="number" class="form-control form-control-sm" min="1" step="1" value="1">
          </td>
          <td>
            <input type="number" class="form-control form-control-sm" step="0.01" value="0.00">
          </td>
          <td>
            <input type="text" class="form-control form-control-sm" readonly value="0.00">
          </td>
          <td>
            <button type="button" class="btn btn-danger btn-sm" onclick="removerLinha(this)">Delete</button>
          </td>
        `;

        tbody.appendChild(novaLinha);
    }

    function removerLinha(botao) {
        // sobe até o <tr> e remove
        const linha = botao.closest("tr");
        linha.remove();
    }

    
</script>