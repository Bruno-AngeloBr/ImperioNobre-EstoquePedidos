@using ImperioNobre.Models.ViewModels
@model AddPedidoViewModel

@{
    Layout = "_LayoutVendedor";
}

@{
    ViewData["Title"] = "AddPedido";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Adicionar - Pedido</h2>
    <button type="submit" class="btn btn-primary">Salvar Pedido</button>
</div>

<br />

<div class="mb-3">
    <label for="pedidoId" class=" form-label lbPedido">Pedido ID: </label>
    <input type="text" class="form-control-sm" id="pedidoId" value="" readonly>
</div>

<div class="mb-3">
    <label for="quantidade" class="form-label lbPedido">Número da Remessa: </label>
    <input type="number" name="quantidade"
           class="form-control-sm input-pequeno"
           min="1" step="1" value="1">
</div>

<!--Nome do cliente-->
<div class="mb-3">
    <label for="cliente" class="form-label lbPedido">Cliente:</label>
    <select id="cliente" name="produto" class="form-select">
        @foreach (var item in Model.Clientes)
        {
            <option value=@item.ClientID>@item.Nome</option>
        }
    </select>
</div>

<!--Exibir ProdutoID / Nome / Sabor-->
<table id="tabelaItens" class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Produto</th>
            <th>Quantidade</th>
            <th>Preço Unitário</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <select class="form-select form-select-sm produto">
                    <option value="" selected disabled>Selecione</option>
                    @foreach (var item in Model.Produtos)
                    {
                        @if (item.QtdDisponivel != 0)
                        {
                            <option value="@item.ProdutosID">
                                @item.Nome - @item.Sabor | @item.Tamanho g
                            </option>
                        }
                    }
                </select>
                <small class="qtdDisponivel text-danger">Disponível: 0 unidades</small>
            </td>
            <td>
                <input type="number" class="form-control form-control-sm quantidade" min="1" step="1" value="1">
            </td>
            <td>
                <input type="number" class="form-control form-control-sm precoUnitario" step="0.01" value="0.00">
            </td>
            <td>
                <input type="text" class="form-control form-control-sm total" readonly value="0.00">
            </td>
            <td>
                <button type="button" class="btn btn-danger btn-sm" onclick="removerLinha(this)">Delete</button>
            </td>
        </tr>
        <!-- Você pode repetir <tr> para mais linhas -->
    </tbody>
</table>

<button type="button" class="btn btn-primary" onclick="adicionarLinha()">+ Adicionar item</button>
<br />
<br />
<br />

<div>
    <label id="TotalPedido" class=" form-label lbPedido">Total: R$ 0,00</label>
</div>


<script>
    //Atualizando o ID do cliente no pedido
    const cliente = document.getElementById("cliente");
    const pedidoId = document.getElementById("pedidoId");

    function atualizarClienteID() {
        pedidoId.value = cliente.value;
    }

    // Quando o usuário trocar o cliente
    cliente.addEventListener("change", atualizarClienteID);

    // Quando a página carregar
    atualizarClienteID();


    function adicionarLinha() {
        const tbody = document.querySelector("#tabelaItens tbody");
        const novaLinha = document.createElement("tr");

        let opcoesProdutos = `
            <option value="" selected disabled>Selecione</option>
        `;

        produtos.forEach(produto => {

            if (produto.QtdDisponivel != 0) {

                opcoesProdutos += `
                    <option value="${produto.ProdutosID}">
                        ${produto.Nome} - ${produto.Sabor} | ${produto.Tamanho}g
                    </option>
                `;
            }
        });

        novaLinha.innerHTML = `
            <td>
                <select class="form-select form-select-sm produto">
                    ${opcoesProdutos}
                </select>

                <small class="qtdDisponivel text-danger">
                    Disponível: 0 unidades
                </small>
            </td>

            <td>
                <input type="number"
                       class="form-control form-control-sm quantidade"
                       min="1"
                       step="1"
                       value="1">
            </td>

            <td>
                <input type="number"
                       class="form-control form-control-sm precoUnitario"
                       step="0.01"
                       value="0.00">
            </td>

            <td>
                <input type="text"
                       class="form-control form-control-sm total"
                       readonly
                       value="0.00">
            </td>

            <td>
                <button type="button"
                        class="btn btn-danger btn-sm"
                        onclick="removerLinha(this)">
                    Delete
                </button>
            </td>
        `;

        tbody.appendChild(novaLinha);

        configurarLinha(novaLinha);
    }

    function removerLinha(botao) {
        // sobe até o <tr> e remove
        const linha = botao.closest("tr");

        linha.remove();

        atualizarTotalPedido();
    }

    //Implementando alterações de quantidade e preço
    //Acessando lista
    const produtos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Produtos));

    function atualizarProduto(select) {

        const linha = select.closest("tr");

        const produtoId = select.value;

        const produto = produtos.find(p => p.ProdutosID == produtoId);

        if (!produto) {
            return;
        }

        const qtdDisponivel = linha.querySelector(".qtdDisponivel");
        const precoUnitario = linha.querySelector(".precoUnitario");
        const quantidade = linha.querySelector(".quantidade");
        const total = linha.querySelector(".total");

        qtdDisponivel.textContent = `Disponível: ${produto.QtdDisponivel} unidades`;

        precoUnitario.value = Number(produto.PrecoUnit).toFixed(2);

        quantidade.max = produto.QtdDisponivel;

        atualizarTotal(linha);
    }

    function atualizarTotal(linha) {

        const quantidade = linha.querySelector(".quantidade");
        const precoUnitario = linha.querySelector(".precoUnitario");
        const total = linha.querySelector(".total");

        const qtd = Number(quantidade.value);
        const preco = Number(precoUnitario.value);

        total.value = (qtd * preco).toFixed(2);
    }

    function configurarLinha(linha) {

        const select = linha.querySelector(".produto");
        const quantidade = linha.querySelector(".quantidade");
        const precoUnitario = linha.querySelector(".precoUnitario");

        select.addEventListener("change", function () {
            atualizarProduto(this);
            atualizarTotalPedido();
        });

        quantidade.addEventListener("input", function () {
            atualizarTotal(linha);
            atualizarTotalPedido();
        });

        precoUnitario.addEventListener("input", function () {
            atualizarTotal(linha);
            atualizarTotalPedido();
        });
    }

    const primeiraLinha =
        document.querySelector("#tabelaItens tbody tr");

    configurarLinha(primeiraLinha);

    function atualizarTotalPedido() {

        const linhas = document.querySelectorAll("#tabelaItens tbody tr");

        let totalPedido = 0;

        linhas.forEach(linha => {

            const total = linha.querySelector(".total");

            if (total) {
                totalPedido += Number(total.value) || 0;
            }

        });

        document.getElementById("TotalPedido").textContent =
            `Total: R$ ${totalPedido.toFixed(2).replace(".", ",")}`;
    }

    
</script>