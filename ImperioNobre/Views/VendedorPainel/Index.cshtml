@model IEnumerable<Produto>

@{
    Layout = "_LayoutVendedor";
}

@{
    ViewData["Title"] = "Bem vindo ao Painel de Vendedor";
}

<h1>@ViewData["Title"]</h1>

<div class="container mt-4">
    <h2>Produtos Disponíveis</h2>
    <br />
    <h5>Estoque:</h5>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Sabor</th>
                <th>Tamanho</th>
                <th>Preço</th>
                <th>Quantidade Disponível</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                @if (item.QtdDisponivel != 0)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Sabor</td>
                        <td>@item.Tamanho g</td>
                        <td>@item.PrecoUnit.ToString("C")</td>
                        <td>@item.QtdDisponivel</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <br />
    
    <a class="btn btn-primary btn-sm fs-5" asp-controller="AdminPainel" asp-action="AddProdutos">+ Adicionar pedido</a>
</div>



