@using ImperioNobre.Models.ViewModels
@model EstoqueViewModel

@{
    Layout = "_LayoutAdmin";
}

@{
    ViewData["Title"] = "Estoque";
}


<h1>@ViewData["Title"]</h1>

<h6>Adicione ou remova itens do seu estoque para disponibilizá-los ao vendedor</h6>
<br />
<div>
    <h4>Estoque geral:</h4>
    
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Sabor</th>
                <th>Tamanho</th>
                <th>Preço</th>
                <th>Quantidade Disponível</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.EstoqueGeral)
            {
                @if (item.QtdDisponivel != 0)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Sabor</td>
                        <td>@item.Tamanho g</td>
                        <td>@item.PrecoUnit.ToString("C")</td>
                        <td>@item.QtdDisponivel</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <br />

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4>Estoque - Ana Laura:</h4>
        <a class="btn btn-primary btn-sm fs-5" href="#" onclick="AltEstoque1()" ; return false;>Editar itens</a>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Sabor</th>
                <th>Tamanho</th>
                <th>Preço</th>
                <th>Quantidade Disponível</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.EstoqueVendedor1)
            {
                @if (item.QtdDisponivel != 0)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Sabor</td>
                        <td>@item.Tamanho g</td>
                        <td>@item.PrecoUnit.ToString("C")</td>
                        <td>@item.QtdDisponivel</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <br />

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4>Estoque - Pablo:</h4>
        <a class="btn btn-primary btn-sm fs-5" href="#" onclick="AltEstoque2()"; return false;>Editar itens</a>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Sabor</th>
                <th>Tamanho</th>
                <th>Preço</th>
                <th>Quantidade Disponível</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.EstoqueVendedor2)
            {
                @if (item.QtdDisponivel != 0)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Sabor</td>
                        <td>@item.Tamanho g</td>
                        <td>@item.PrecoUnit.ToString("C")</td>
                        <td>@item.QtdDisponivel</td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>

<script>
    // Selecionando qual estoque será solicitado para alteração
    var estoque;

    //Enviando variável que define o estoque para o controlador e para a Ação AddProdutos
    function AltEstoque1() {
        estoque = 1;
        
        window.location.href = '/AdminPainel/AddProdutos?estoque=' + estoque;
    }

    function AltEstoque2() {
        estoque = 2;

        window.location.href = '/AdminPainel/AddProdutos?estoque=' + estoque;
    }

</script>

