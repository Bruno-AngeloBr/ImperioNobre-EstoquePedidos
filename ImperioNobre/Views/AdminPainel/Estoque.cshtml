@{
    Layout = "_LayoutAdmin";
}

@{
    ViewData["Title"] = "Estoque";
}



<h1>@ViewData["Title"]</h1>

<h6>Adicione ou remova itens do seu estoque para disponibilizá-los ao vendedor</h6>
<br />
<div>
    <div class ="d-flex justify-content-between align-items-center mb-3">
        <h2>Produtos disponíveis:</h2>
        <a class="btn btn-primary btn-sm fs-5" asp-controller="AdminPainel" asp-action="AddProdutos">Editar itens</a>
    </div>
    
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Sabor</th>
                <th>Tamanho</th>
                <th>Preço</th>
                <th>Quantidade Disponível</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Cookie</td>
                <td>Nutella</td>
                <td>110g</td>
                <td>R$ 5,00</td>
                <td>20</td>
            </tr>
            <tr>
                <td>Café</td>
                <td>Ninho</td>
                <td>115g</td>
                <td>R$ 3,00</td>
                <td>15</td>
            </tr>
        </tbody>
    </table>


</div>

