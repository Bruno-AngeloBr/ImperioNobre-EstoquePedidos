@model IEnumerable<Produto>

@{
    Layout = "_LayoutAdmin";
}

@{
    ViewData["Title"] = "Estoque";
}



<h1>@ViewData["Title"]</h1>

<h6>Adicione ou remova itens do seu estoque para disponibilizá-los ao vendedor</h6>
<br />
<div>
    <div class ="d-flex justify-content-between align-items-center mb-3">
        <h2>Produtos disponíveis:</h2>
        <a class="btn btn-primary btn-sm fs-5" asp-controller="AdminPainel" asp-action="AddProdutos">Editar itens</a>
    </div>
    
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Sabor</th>
                <th>Tamanho</th>
                <th>Preço</th>
                <th>Quantidade Disponível</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                @if (item.QtdDisponivel != 0)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Sabor</td>
                        <td>@item.Tamanho g</td>
                        <td>@item.PrecoUnit.ToString("C")</td>
                        <td>@item.QtdDisponivel</td>
                    </tr>
                }
            }
        </tbody>
    </table>


</div>

